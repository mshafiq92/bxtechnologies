{
  "name": "bxtechnologies-web",
  "version": "0.1.0",
  "private": true,
  "description": "bX Technologies company website (v2, bX Light design)",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:visual": "playwright test --project=visual-1440 --project=visual-390",
    "lighthouse": "lhci autorun",
    "guard": "node scripts/guardrails.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run guard"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.5",
    "clsx": "^2.1.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
