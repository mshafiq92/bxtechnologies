{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": [".next/**", "out/**", "coverage/**", ".claude/**", "node_modules/**"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "utility",
          "variant",
          "custom-variant",
          "apply",
          "source",
          "plugin",
          "config",
          "reference"
        ]
      }
    ],
    "at-rule-no-deprecated": null,
    "import-notation": "string",
    "custom-property-pattern": null,
    "selector-class-pattern": null,
    "declaration-property-value-no-unknown": null,
    "color-no-hex": [
      true,
      {
        "message": "Use a token from styles/tokens.css, not a raw colour."
      }
    ],
    "color-named": [
      "never",
      {
        "message": "Use a token from styles/tokens.css, not a named colour."
      }
    ],
    "function-disallowed-list": [
      ["rgb", "rgba", "hsl", "hsla", "hwb", "lab", "lch", "oklab", "oklch", "color"],
      {
        "message": "Use a token from styles/tokens.css, not a raw colour function."
      }
    ],
    "nesting-selector-no-missing-scoping-root": null
  },
  "overrides": [
    {
      "files": ["styles/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null
      }
    }
  ]
}
