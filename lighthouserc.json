{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3200",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/services",
        "http://localhost:3200/services/agentic-ai",
        "http://localhost:3200/work",
        "http://localhost:3200/insights",
        "http://localhost:3200/insights/agent-projects-fail-at-the-evaluation-harness",
        "http://localhost:3200/about",
        "http://localhost:3200/careers/apply",
        "http://localhost:3200/contact",
        "http://localhost:3200/privacy"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
