# Copy to .env.local for development. Never commit real values.
# Production values live on the VPS; preview/staging values live in Vercel.

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" on every non-production environment (Vercel previews, staging, rehearsal).
# On Vercel it is on by default even if unset; only "false" turns it off (never do that on Vercel).
SITE_NOINDEX=true

# Password protection (HTTP basic auth) for staging and previews; see proxy.ts.
# Off unless BOTH are set. Never set them on the production VPS.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Show /dev/* review routes in a production build (never on the live site)
ENABLE_DEV_ROUTES=false

# Form email (Resend), task T40
# Verify bxtechnologies.net in Resend (SPF + DKIM records) before going live.
# Without RESEND_API_KEY, development logs the email instead of sending it; production fails loudly.
RESEND_API_KEY=
MAIL_FROM="bX Technologies <website@bxtechnologies.net>"
MAIL_TO_ENQUIRIES=info@bxtechnologies.net
MAIL_TO_CAREERS=jobs@bxtechnologies.net

# Spam protection (Cloudflare Turnstile), task T40
# Local testing: Cloudflare's always-pass test keys are
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
# Without TURNSTILE_SECRET_KEY the check is skipped in development and fails in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CV upload limit in MB (default 10). Set 4 on Vercel: Vercel caps a request at 4.5 MB.
NEXT_PUBLIC_CV_MAX_MB=

# End-to-end tests only: log emails and skip Turnstile. NEVER set this on a real deployment.
FORMS_DRY_RUN=false

# Analytics: Plausible (cookieless). Loads ONLY after the visitor accepts in the cookie banner.
# Empty = no analytics. Domain as registered in Plausible, e.g. bxtechnologies.net.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: script URL (default https://plausible.io/js/script.js; change if self-hosted).
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Error monitoring (Sentry), used from task T44
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
